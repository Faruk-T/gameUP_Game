# Auto detect text files and perform LF normalization
* text=auto

# C# and shader scripts
*.cs text diff=csharp eol=crlf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.inputactions text eol=lf
*.md text eol=lf

# Unity YAML files (use Unity SmartMerge when configured, enforce LF to avoid phantom diffs)
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.mat text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.anim text merge=unityyamlmerge eol=lf
*.meta text merge=unityyamlmerge eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.obj binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary

